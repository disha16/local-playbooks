{
  "name": "local-playbooks",
  "version": "0.2.0",
  "description": "Turn your Screenpipe screen history into summaries and step-by-step playbooks, with AI that runs on your own machine.",
  "type": "module",
  "bin": {
    "local-playbooks": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
