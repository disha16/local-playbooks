    "bundle:check": "node scripts/check-desktop-bundle.js",
    "dist": "npm run bundle:check && electron-builder --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "screenpipe",
    "local-ai",
    "on-prem",
    "llama.cpp",
    "sop",
    "playbook",
    "privacy"
  ],
  "author": "Disha Rawal",
  "license": "MIT",
  "main": "desktop/main.js",
  "dependencies": {
    "node-llama-cpp": "3.22.3",
    "@huggingface/transformers": "4.3.2"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1"
  }
}
